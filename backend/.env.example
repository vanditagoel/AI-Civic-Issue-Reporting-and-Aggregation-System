# ==============================================================================
# CivicLens Backend Environment Variables
# ==============================================================================

# Core Django Settings
SECRET_KEY=civiclens-dev-insecure-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL is required. SQLite is explicitly prohibited)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# For Neon / Render external PostgreSQL: postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/civiclens?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civiclens_db

# Google Gemini Intelligence Pipeline
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Processing Pipeline Execution Mode
# 'inline': Processes reports synchronously within the request transaction (ideal for low-cost / demo environments)
# 'worker': Enqueues jobs to ProcessingJob table, processed by 'python manage.py run_worker'
JOB_RUNNER=inline

# Network & Cross-Origin Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (For Next.js App Router)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
